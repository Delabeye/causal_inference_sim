<?xml version="1.0"?>
<robot name="cube">

  <link name="base_link">
    <inertial>
      <mass value="1.0"/> 
      <inertia ixx="0.02" ixy="0.0" ixz="0.0" iyy="0.02" iyz="0.0" izz="0.02"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      
      <geometry>
        <box size="0.1 0.1 0.1"/>
      </geometry>
      
      <material name="red">
        <color rgba="1 0 0 1"/> </material>
    </visual>

  </link>

</robot>