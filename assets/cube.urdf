<?xml version="1.0"?>
<robot name="cube">

  <link name="base_link">
    
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      
      <geometry>
        <box size="0.1 0.1 0.1"/>
      </geometry>
      
      <material name="red">
        <color rgba="1 0 0 1"/> </material>
    </visual>

  </link>

</robot>