flowchart LR
  %% =======================
  %% Application layer (small)
  %% =======================
  subgraph Application
    user[User]
    main[main_py]
  end

  %% Nodes just outside Application
  config[config_yaml]
  sim[SimulationManager]

  %% =======================
  %% Physics layer
  %% =======================
  subgraph Physics
    pyb[PyBullet]
    world[World]
  end

  %% =======================
  %% Swarm layer
  %% =======================
  subgraph SwarmLayer
    swarm[Swarm]
  end

  %% =======================
  %% UAV and control layer
  %% =======================
  subgraph UAVLayer
    agent[Agent]
    uav[UAV]
    pid[PID]
    ekf[GPSEKF]
    logger[LoggerCSV]
  end

  %% =======================
  %% Sensor layer
  %% =======================
  subgraph SensorLayer
    sensors[Sensors]
    gps[GPSSensor]
    imu[IMUSensor]
    lidar[LidarSensor]
  end

  %% -------- Application flow --------
  user -->|configure_scenario| config
  config -->|loaded_by| main
  main -->|create_simulation| sim

  %% -------- Simulation and physics --------
  sim -->|init_physics| pyb
  sim -->|create_world| world
  sim -->|create_swarm| swarm
  sim -->|create_uav| uav

  %% -------- Swarm manages UAVs --------
  swarm -->|manage_uav| uav

  %% -------- Inheritance --------
  agent -->|base_class_of| uav

  %% -------- UAV composition --------
  uav --> pid
  uav --> ekf
  uav --> logger
  uav --> sensors

  %% -------- Sensors inside UAV --------
  sensors --> gps
  sensors --> imu
  sensors --> lidar

  %% -------- Data flow --------
  pyb -->|ground_truth_state| uav

  gps -->|gps_measurements| uav
  gps -->|gps_measurements| ekf
  imu -->|imu_measurements| uav
  lidar -->|lidar_measurements| uav

  %% EKF provides estimated state both to UAV logic and PID controller
  ekf -->|estimated_state| uav
  ekf -->|estimated_state| pid

  %% Logging of all data
  uav -->|log_data| logger
